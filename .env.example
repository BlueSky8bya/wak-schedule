# 우왁굳 일정표 — 환경 변수 템플릿
# 로컬: 이 파일을 .env.local로 복사해 채운다. (.env.local은 git에 올라가지 않음)
# 프로덕션(Vercel): 아래 값들을 Vercel 프로젝트 Settings → Environment Variables에 등록한다.
# NEXT_PUBLIC_ 접두사 변수는 브라우저에 노출된다(공개 가능 값만). 나머지는 서버 전용 비밀.

# ── Supabase (필수) ───────────────────────────────────────────────
# Supabase 대시보드 → Project Settings → API 에서 확인.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon public key>
# service_role 키 — 절대 클라이언트에 노출 금지(서버 전용). 개발자/소유자 판별에 사용.
SUPABASE_SERVICE_ROLE_KEY=<service role secret key>

# ── 사이트 URL (프로덕션 필수) ────────────────────────────────────
# 배포된 정식 도메인. Google OAuth 리다이렉트와 Supabase 허용목록이 이 값과 일치해야 한다.
# (비워두면 Vercel 프로덕션 도메인으로 자동 폴백되지만, 명시 권장)
NEXT_PUBLIC_SITE_URL=https://your-domain

# ── 소유자(스트리머) (필수) ──────────────────────────────────────
# 이 구글 이메일로 로그인하면 owner(전체 편집권). 콤마로 여러 계정 등록 가능.
# ⚠ 소유자 이전은 이 값 하나로 끝나지 않는다 — DB의 calendars.owner_id(RLS 기준)도 함께 옮겨야
#   저장이 된다(db/seeds/0003_transfer_owner.sql).
OWNER_EMAIL=owner-google-email@example.com

# ── 달력 슬러그 ──────────────────────────────────────────────────
# DB calendars.slug이자 공개 API 경로 /api/public/<slug>/*. 기본값 "wak".
NEXT_PUBLIC_CALENDAR_SLUG=wak

# ── 라이브 배지(방송 중 표시) ────────────────────────────────────
# 플랫폼: soop(기본) | chzzk | none. 채널 id가 비어 있으면 라이브 기능이 조용히 꺼진다.
LIVE_PROVIDER=soop
# SOOP(구 아프리카TV) BJ 아이디. 우왁굳님 채널: https://ch.sooplive.co.kr/ecvhao
SOOP_BJ_ID=ecvhao
# 치지직으로 옮길 경우에만 사용(LIVE_PROVIDER=chzzk).
CHZZK_CHANNEL_ID=

# ── 서버 구간 로깅 ───────────────────────────────────────────────
# off로 두면 [perf] 콘솔 로그만 꺼진다(계측 자체는 오버헤드 무시 수준).
PERF_LOG=on

# ── DB 마이그레이션 스크립트 전용 (런타임 아님) ──────────────────
# scripts/apply-db.mjs / verify-db.mjs 가 직접 DB 접속할 때만 사용. Vercel에는 넣지 않아도 됨.
# Supabase 대시보드 → Project Settings → Database → Connection 의 비밀번호.
SUPABASE_DB_PASSWORD=<database password>
